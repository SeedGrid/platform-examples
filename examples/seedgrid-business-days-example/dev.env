APP_NAME=seedgrid-business-days-example
HTTP_PORT=8093

SEEDGRID_DB_URL=jdbc:postgresql://localhost:5439/business_days_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

SECURITY_JWT_ISSUER=http://localhost:8093
SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SECURITY_ENCRYPTION_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=

SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=admin@example.com
# Senha do admin criado no primeiro boot. Em branco, a extensao gera uma senha
# aleatoria e a envia por e-mail. Preenchida aqui para voce entrar de primeira.
# EM PRODUCAO: deixe em branco e configure um SMTP de verdade.
SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD=Admin@123
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME=Admin
SEEDGRID_SECURITY_FIRST_ADMIN_USER_WHATSAPP=5511999999999

SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=12345678000199
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME=Business Days Example LTDA
SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME=Business Days Example


LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG

# ========================================
# E-MAIL (Mailpit do infra/compose.yml)
# ========================================
# Tudo que a aplicacao enviar aparece em http://localhost:8025 — nada sai para a
# internet. E' assim que voce pega o link de confirmacao do primeiro login.
# EM PRODUCAO: troque por um SMTP de verdade.
SECURITY_MAILER_FROM=nao-responda@exemplo.com.br
SECURITY_MAILER_HOST=localhost
SECURITY_MAILER_PORT=1025
SECURITY_MAILER_START_TLS=DISABLED
SECURITY_MAILER_USERNAME=
SECURITY_MAILER_PASSWORD=
