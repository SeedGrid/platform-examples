APP_NAME=seedgrid-backup-example
HTTP_PORT=8089

SEEDGRID_DB_URL=jdbc:postgresql://localhost:5432/backup_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

SECURITY_JWT_ISSUER=http://localhost:8089
SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SECURITY_ENCRYPTION_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=

SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=admin@example.com
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME=Admin
