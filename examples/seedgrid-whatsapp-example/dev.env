APP_NAME=seedgrid-whatsapp-example
HTTP_PORT=8091

SEEDGRID_DB_URL=jdbc:postgresql://localhost:5432/whatsapp_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

# Provider Evolution API (self-hosted). Aponte para uma instancia real da Evolution API para
# enviar mensagens de verdade; sem isso, os envios vao falhar com erro do rest client (a
# notificacao ainda e' registrada localmente com status FAILED).
SEEDGRID_WHATSAPP_API=evolution
SEEDGRID_WHATSAPP_REST_CLIENT_EVOLUTION_URL=http://localhost:8095
SEEDGRID_WHATSAPP_EVOLUTION_API_KEY=changeme

WHATSAPP_CHANNEL_ID=example-instance

LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG
