# ========================================
# APLICACAO GERAL
# ========================================
APP_NAME=seedgrid-login-tenancy-example
APP_CODE=login-tenancy-example
HTTP_PORT=8086

# ========================================
# DATASOURCE (unico)
# ========================================
SEEDGRID_DB_URL=jdbc:postgresql://localhost:5439/login_tenancy_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

# ========================================
# SEEDGRID SECURITY (JWT)
# ========================================
SECURITY_JWT_ISSUER=http://localhost:8086
SECURITY_JWT_KID=seedgrid-key
SECURITY_JWT_TTL=PT8H
SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SECURITY_ENCRYPTION_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=

SECURITY_FRONTEND_BASE_URL=http://localhost:3000

# Mailer (deixe em branco para usar apenas logs; senha/app-password caso use Gmail SMTP)
SECURITY_MAILER_FROM=nao-responda@exemplo.com.br
SECURITY_MAILER_HOST=localhost
SECURITY_MAILER_PORT=1025
SECURITY_MAILER_USERNAME=
SECURITY_MAILER_PASSWORD=

# ========================================
# AUDIT
# ========================================
AUDIT_STRATEGY=JPA

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG

# ========================================
# EMPRESA DEFAULT (obrigatoria)
# ========================================
# O seedgrid-security declara estas tres SEM valor default: sem elas o boot morre
# em SRCFG00011 antes de abrir a porta. E' a empresa da plataforma, criada no
# primeiro startup e usada como referencia pelo RBAC.
SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=00000000000191
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME="Exemplo Login Tenancy LTDA"
SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME="Exemplo Login Tenancy"

# Admin criado no primeiro boot — entre com esta senha no Swagger.
# EM PRODUCAO: deixe a senha em branco e configure um SMTP de verdade.
SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=admin@exemplo.com.br
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME="Admin do Exemplo"
SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD=Admin@123
