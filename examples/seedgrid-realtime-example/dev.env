APP_NAME=seedgrid-realtime-example
HTTP_PORT=8090

SEEDGRID_DB_URL=jdbc:postgresql://localhost:5439/realtime_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

SECURITY_JWT_ISSUER=http://localhost:8090
SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SECURITY_ENCRYPTION_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=

SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=admin@example.com
# Senha do admin criado no primeiro boot. EM PRODUCAO: deixe em branco e configure um SMTP de verdade.
SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD=Admin@123
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME=Admin
SEEDGRID_SECURITY_FIRST_ADMIN_USER_WHATSAPP=5511999999999

SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=12345678000199
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME=Realtime Example LTDA

# Realtime: ligado, falando com o Pulse FALSO que o proprio exemplo serve em /fake-pulse.
# Num produto: a URL do Pulse e a chave `project` da conta (segredo, so no env do backend).
SEEDGRID_REALTIME_ENABLED=true
SEEDGRID_REALTIME_PULSE_BASE_URL=http://localhost:8090/fake-pulse
SEEDGRID_REALTIME_PULSE_PROJECT_KEY=chave-de-exemplo-sem-valor
