# ============================================================================
# dev.env — variaveis do exemplo de subdomain-tenancy.
#
# Todo nome aqui e' o nome CANONICO que a lib le (SEEDGRID_<MODULO>_*). O
# application.properties nao redeclara mais essas chaves, entao o que esta
# escrito neste arquivo e' o que vale de verdade. Antes metade era ignorada:
# o dev.env usava SEEDGRID_SUBDOMAIN_TENANCY_* e o application.properties lia
# SEEDGRID_MULTITENANCY_* (nome antigo), vencendo por ter prioridade maior.
#
# Para conferir um nome: unzip -p ~/.m2/.../seedgrid-<modulo>-<ver>.jar \
#   META-INF/microprofile-config.properties | grep <chave>
# ============================================================================

# ========================================
# APLICACAO GERAL
# ========================================
APP_NAME=seedgrid-test-quarkus
HTTP_PORT=8085

# ========================================
# SEEDGRID SUBDOMAIN-TENANCY
# ========================================
PRODUCT_PREFIX=crm
SEEDGRID_SUBDOMAIN_TENANCY_DOMAIN_SUFFIX=crm.exemplo.com.br
SEEDGRID_SUBDOMAIN_TENANCY_USE_HTTPS=false
SEEDGRID_SUBDOMAIN_TENANCY_PORT=8085

# Entity Packages
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_ENTITY_PACKAGES=br.com.seedgrid.subdomaintenancyexample.entity.master
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_ENTITY_PACKAGES=br.com.seedgrid.subdomaintenancyexample.entity.tenant

# Cleanup de tenants nao validados. Atencao: a lib usa CLEANUP_, nao CLEAN_.
SEEDGRID_SUBDOMAIN_TENANCY_CLEANUP_NOT_VALIDATED_TTL=PT5M
SEEDGRID_SUBDOMAIN_TENANCY_CLEANUP_NOT_VALIDATED_CRON="0 0/5 * * * ?"
SEEDGRID_SUBDOMAIN_TENANCY_TRIAL_DAYS=1

# Admin inicial
SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_NAME="Admin do Exemplo"
SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_EMAIL=admin@exemplo.com.br
# Senha do admin criado no primeiro boot. Se ficar em branco, a extensao gera uma
# senha aleatoria e a envia por e-mail — o que so funciona com SMTP configurado.
# Preenchida aqui para voce conseguir entrar no Swagger imediatamente.
# EM PRODUCAO: deixe em branco e configure o SMTP.
SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_INITIAL_PASSWORD=Admin@123

# ========================================
# DATASOURCE MASTER (tabelas de controle)
# ========================================
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_URL=jdbc:postgresql://localhost:5439/crm_master
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_USERNAME=postgres
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_PASSWORD=postgres
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_POOL_MIN=1
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_POOL_MAX=10

# ========================================
# DATASOURCE TENANTS (um banco por tenant)
# ========================================
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_URL=jdbc:postgresql://localhost:5439
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_USERNAME=postgres
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_PASSWORD=postgres
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_POOL_MIN=1
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_POOL_MAX=10

# ========================================
# MAILER DO SUBDOMAIN-TENANCY
# ========================================
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_FROM=nao-responda@exemplo.com.br
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_HOST=localhost
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_PORT=1025
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_START_TLS=DISABLED
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_USERNAME=
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_PASSWORD=

# ========================================
# SEEDGRID BILLING
# ========================================
SEEDGRID_BILLING_DEFAULT_PLAN=ASDF11
SEEDGRID_BILLING_STRIPE_WEBHOOK_SECRET=xxx
SEEDGRID_BILLING_STRIPE_APIKEY=xxx
SEEDGRID_BILLING_STRIPE_DEFAULT_SUCCESS_URL=xxx
SEEDGRID_BILLING_STRIPE_DEFAULT_CANCEL_URL=xxx

# ========================================
# SEEDGRID API KEYS
# ========================================
SEEDGRID_APIKEYS_PREFIX_LENGTH=8
SEEDGRID_APIKEYS_KEY_BYTES=32

# ========================================
# SEEDGRID SECURITY
# ========================================
# Empresa default: as tres primeiras sao OBRIGATORIAS (a lib as declara sem
# valor default). Sem elas o boot morre em SRCFG00011 antes de abrir a porta.
SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=00000000000191
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME="SeedGrid Exemplo LTDA"
SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME="SeedGrid Exemplo"

# JWT
SEEDGRID_SECURITY_JWT_ISSUER=https://seedgrid.com.br
SEEDGRID_SECURITY_JWT_KID=seedgrid-test-key
SEEDGRID_SECURITY_JWT_TTL=PT8H
SEEDGRID_SECURITY_JWT_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SEEDGRID_SECURITY_JWT_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SEEDGRID_SECURITY_REFRESH_TOKEN_TTL=P30D

# Politica de senha
SEEDGRID_SECURITY_PASSWORD_MIN_SIZE=8
SEEDGRID_SECURITY_PASSWORD_UPPER=true
SEEDGRID_SECURITY_PASSWORD_LOWER=true
SEEDGRID_SECURITY_PASSWORD_SPECIAL=true
SEEDGRID_SECURITY_PASSWORD_NO_REPEAT=true
SEEDGRID_SECURITY_PASSWORD_EXPIRATION_DAYS=90
SEEDGRID_SECURITY_PASSWORD_MAX_HISTORY=5

# Mailer do security
SEEDGRID_SECURITY_MAILER_FROM=nao-responda@exemplo.com.br
SEEDGRID_SECURITY_MAILER_HOST=localhost
SEEDGRID_SECURITY_MAILER_PORT=1025
SEEDGRID_SECURITY_MAILER_START_TLS=DISABLED
SEEDGRID_SECURITY_MAILER_USERNAME=
SEEDGRID_SECURITY_MAILER_PASSWORD=

# Frontend (usado nos links dos e-mails)
SEEDGRID_SECURITY_FRONTEND_BASE_URL=http://crm-dev.exemplo.com.br:3000

# Avatar
# Avatar no MinIO que o infra/compose.yml sobe, com o bucket seedgrid-avatars
# ja criado — e' o caminho mais parecido com producao, e nao custa configuracao
# nenhuma porque o compose ja deixa tudo pronto.
SEEDGRID_SECURITY_AVATAR_STORAGE=minio
SEEDGRID_SECURITY_AVATAR_MINIO_ENDPOINT=http://localhost:9010
SEEDGRID_SECURITY_AVATAR_MINIO_BUCKET=seedgrid-avatars
SEEDGRID_SECURITY_AVATAR_MINIO_REGION=us-east-1
SEEDGRID_SECURITY_AVATAR_MINIO_ACCESS_KEY=minioadmin
SEEDGRID_SECURITY_AVATAR_MINIO_SECRET_KEY=minioadmin

# Para gravar em disco em vez do MinIO, troque STORAGE para "filesystem":
# SEEDGRID_SECURITY_AVATAR_FILESYSTEM_BASE_PATH=./target/seedgrid-avatars

# Encryption (32 bytes)
SEEDGRID_SECURITY_ENCRYPTION_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=
SEEDGRID_SECURITY_2F_EMAIL_CODE_TTL=PT1M
SEEDGRID_SECURITY_RBAC_CACHE_TTL=PT5M

# ========================================
# SEEDGRID AUDIT
# ========================================
# Este exemplo e' MONGODB (o pom traz so o provider mongodb). Trocar pra JPA
# exige mexer no pom, nao basta mudar aqui.
AUDIT_STRATEGY=MONGODB
SEEDGRID_AUDIT_MONGODB_URI=mongodb://admin:admin@localhost:27019

# ========================================
# SEEDGRID BACKUP
# ========================================
SEEDGRID_BACKUP_RETENTION_DAYS=7
SEEDGRID_BACKUP_MAX_CONCURRENT_EXPORTS=1
SEEDGRID_BACKUP_QUEUE_POLL_INTERVAL=30s
SEEDGRID_BACKUP_NOTIFICATION_POLL_INTERVAL=5m
SEEDGRID_BACKUP_NOTIFICATION_MAX_RETRIES=3
SEEDGRID_BACKUP_NOTIFICATION_RETRY_DELAY=PT15M

# Mailer do backup
SEEDGRID_BACKUP_MAILER_FROM=nao-responda@exemplo.com.br
SEEDGRID_BACKUP_MAILER_HOST=localhost
SEEDGRID_BACKUP_MAILER_PORT=1025
SEEDGRID_BACKUP_MAILER_START_TLS=DISABLED
SEEDGRID_BACKUP_MAILER_USERNAME=
SEEDGRID_BACKUP_MAILER_PASSWORD=

# Storage
SEEDGRID_BACKUP_STORAGE=filesystem
SEEDGRID_BACKUP_FILESYSTEM_BASE=C:\temp\seedgrid-backup
SEEDGRID_BACKUP_MINIO_BUCKET=
SEEDGRID_BACKUP_MINIO_REGION=us-east-1
SEEDGRID_BACKUP_MINIO_ACCESS_KEY=
SEEDGRID_BACKUP_MINIO_SECRET_KEY=
SEEDGRID_BACKUP_MINIO_ENDPOINT=

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG
LOG_FILEMANAGEMENT_LEVEL=DEBUG
LOG_MINIO_LEVEL=DEBUG
LOG_OKHTTP_LEVEL=DEBUG
LOG_HIBERNATE_LEVEL=INFO
LOG_VERTX_MAIL_LEVEL=DEBUG
LOG_QUARKUS_MAILER_LEVEL=DEBUG
