APP_NAME=seedgrid-filemanagement-example
HTTP_PORT=8089

# Diretorio-base do FilesystemStorage em modo dev. Troque por um caminho persistente se quiser
# manter os arquivos entre reinicios (o default fica sob o temp dir do SO).
#STORAGE_BASE_PATH=/var/seedgrid/files

LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG

# Anexos ligados: Postgres do infra/compose.yml
SEEDGRID_DB_URL=jdbc:postgresql://localhost:5439/filemanagement_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres
