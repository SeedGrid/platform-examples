APP_NAME=seedgrid-privacy-example
HTTP_PORT=8092

SEEDGRID_DB_URL=jdbc:postgresql://localhost:5432/privacy_example
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

# Criptografia at-rest LIGADA. Em producao, TROQUE as duas chaves abaixo por segredos gerados e
# guardados fora do repo (Vault/secret manager). Cada chave e' Base64 de no minimo 32 bytes; a
# crypto.key (AES-256-GCM) e a search.key (HMAC-SHA256) DEVEM ser diferentes.
#   Gere uma chave nova assim:  openssl rand -base64 32
SEEDGRID_PRIVACY_ENCRYPTION_ENABLED=true
SEEDGRID_CRYPTO_KEY=base64:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
SEEDGRID_SEARCH_KEY=base64:YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXpBQkNERUY=

LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG
