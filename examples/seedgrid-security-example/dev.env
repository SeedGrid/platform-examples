# ========================================
# APLICACAO GERAL
# ========================================
APP_NAME=seedgrid-test-quarkus
HTTP_PORT=8085

# ========================================
# BANCO PRINCIPAL
# ========================================
SEEDGRID_DB_URL=jdbc:postgresql://localhost:5439/clinica
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

# ========================================
# SEEDGRID SECURITY - HOST APP
# ========================================
# JWT
SECURITY_JWT_ISSUER=https://seedgrid.com.br
SECURITY_JWT_KID=seedgrid-test-key
SECURITY_JWT_TTL=PT8H
SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SECURITY_REFRESH_TOKEN_TTL=P30D

# Password policy
SECURITY_PASSWORD_MIN_SIZE=8
SECURITY_PASSWORD_UPPER=true
SECURITY_PASSWORD_LOWER=true
SECURITY_PASSWORD_SPECIAL=true
SECURITY_PASSWORD_NO_REPEAT=true
SECURITY_PASSWORD_EXPIRATION_DAYS=90
SECURITY_PASSWORD_MAX_HISTORY=5

# 2FA / RBAC
SEEDGRID_SECURITY_2F_EMAIL_CODE_TTL=PT1M
SECURITY_RBAC_CACHE_TTL=PT5M

# Frontend
SECURITY_FRONTEND_BASE_URL=http://localhost:8080
SECURITY_FRONTEND_LOGIN_PATH=/login
SECURITY_FRONTEND_PASSWORD_RESET_PATH=/auth/forgot-password/confirm
SECURITY_FRONTEND_EMAIL_CONFIRMATION_PATH=/auth/confirm-email
SECURITY_FRONTEND_WELCOME_PATH=/auth/welcome

# Mailer
SECURITY_MAILER_FROM=nao-responda@exemplo.com.br
SECURITY_MAILER_HOST=localhost
SECURITY_MAILER_PORT=1025
SECURITY_MAILER_START_TLS=DISABLED
SECURITY_MAILER_USERNAME=
SECURITY_MAILER_PASSWORD=

# Encryption
SECURITY_ENCRYPTION_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=

# ========================================
# SEEDGRID SECURITY - MODULE ALIASES
# ========================================
# These cover variables referenced directly by seedgrid-security defaults.
SEEDGRID_SECURITY_MAILER_FROM=nao-responda@exemplo.com.br
SEEDGRID_SECURITY_MAILER_HOST=localhost
SEEDGRID_SECURITY_MAILER_PORT=1025
SEEDGRID_SECURITY_MAILER_START_TLS=DISABLED
SEEDGRID_SECURITY_MAILER_USERNAME=
SEEDGRID_SECURITY_MAILER_PASSWORD=

SEEDGRID_SECURITY_FRONTEND_BASE_URL=http://localhost:8080
SEEDGRID_SECURITY_FRONTEND_LOGIN_PATH=/login
SEEDGRID_SECURITY_FRONTEND_PASSWORD_RESET_PATH=/auth/forgot-password/confirm
SEEDGRID_SECURITY_FRONTEND_EMAIL_CONFIRMATION_PATH=/auth/confirm-email
SEEDGRID_SECURITY_FRONTEND_WELCOME_PATH=/auth/welcome
SEEDGRID_SECURITY_FRONTEND_SELF_ENTER_PATH=/auth/self-enter

SEEDGRID_SECURITY_JWT_ISSUER=https://seedgrid.com.br
SEEDGRID_SECURITY_JWT_KID=seedgrid-test-key
SEEDGRID_SECURITY_JWT_TTL=PT8H
SEEDGRID_SECURITY_JWT_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SEEDGRID_SECURITY_JWT_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem

SEEDGRID_SECURITY_RATE_LIMIT_LOGIN_ENABLED=true
SEEDGRID_SECURITY_RATE_LIMIT_LOGIN_MAX_REQUESTS=100
SEEDGRID_SECURITY_RATE_LIMIT_LOGIN_WINDOW=PT1M

# First admin user
SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=voce@exemplo.com.br
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME="Administrador Inicial"
SEEDGRID_SECURITY_FIRST_ADMIN_USER_WHATSAPP=5516981295353
SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD=Admin@123

# WhatsApp 2FA
SEEDGRID_SECURITY_2F_WHATSAPP_CHANNEL_ID=luckcel
SEEDGRID_WHATSAPP_API=evolution
SEEDGRID_WHATSAPP_REST_CLIENT_EVOLUTION_URL=https://lck-projects-whatsapp-api.lkvb8o.easypanel.host
SEEDGRID_WHATSAPP_EVOLUTION_API_KEY=COLOQUE_SUA_EVOLUTION_API_KEY_AQUI

# Default company
SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=08.803.493/0001-00
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME="Empresa Default LTDA"
SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME="Empresa Default"
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_STREET="Rua Empresa Default"
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_NUMBER=100
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_COMPLEMENT="Sala 1"
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_POSTAL_CODE=01001-000
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_CITY="Sao Paulo"
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_STATE=SP
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_DISTRICT=Centro
SEEDGRID_SECURITY_DEFAULT_COMPANY_ADDR_PHONE=1130000000
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_FIRST_NAME=Representante
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_LAST_NAME=Default
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_CPF=12345678900
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_BIRTH_DATE=1990-01-01
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_PHONE=11999990000
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_WHATSAPP=11999990000
SEEDGRID_SECURITY_DEFAULT_COMPANY_REP_EMAIL=empresa.default@seedgrid.local

# ========================================
# AVATAR STORAGE
# ========================================
# Avatar em disco: assim o exemplo roda so com o compose deste repositorio,
# sem depender de nenhum servico externo. O caminho e' relativo ao projeto e
# some com `mvn clean`.
#
# O backend e' intercambiavel — para ver isso na pratica, suba um MinIO e troque
# STORAGE para "minio", preenchendo o bloco mais abaixo. Vale o mesmo para "s3".
# Avatar no MinIO que o infra/compose.yml sobe, com o bucket seedgrid-avatars
# ja criado — e' o caminho mais parecido com producao, e nao custa configuracao
# nenhuma porque o compose ja deixa tudo pronto.
SEEDGRID_SECURITY_AVATAR_STORAGE=minio
SEEDGRID_SECURITY_AVATAR_MINIO_ENDPOINT=http://localhost:9010
SEEDGRID_SECURITY_AVATAR_MINIO_BUCKET=seedgrid-avatars
SEEDGRID_SECURITY_AVATAR_MINIO_REGION=us-east-1
SEEDGRID_SECURITY_AVATAR_MINIO_ACCESS_KEY=minioadmin
SEEDGRID_SECURITY_AVATAR_MINIO_SECRET_KEY=minioadmin

# Para gravar em disco em vez do MinIO, troque STORAGE para "filesystem":
# SEEDGRID_SECURITY_AVATAR_FILESYSTEM_BASE_PATH=./target/seedgrid-avatars
SEEDGRID_SECURITY_AVATAR_USER_PREFIX=avatars/users
SEEDGRID_SECURITY_AVATAR_DEFAULT_PREFIX=avatars/defaults
SEEDGRID_SECURITY_AVATAR_PUBLIC_READ=false


# S3
# SEEDGRID_SECURITY_AVATAR_S3_BUCKET=
# SEEDGRID_SECURITY_AVATAR_S3_REGION=
# SEEDGRID_SECURITY_AVATAR_S3_ACCESS_KEY=
# SEEDGRID_SECURITY_AVATAR_S3_SECRET_KEY=
# SEEDGRID_SECURITY_AVATAR_S3_ENDPOINT=

# MinIO

# Azure Blob
SEEDGRID_SECURITY_AVATAR_AZURE_BLOB_CONNECTION_STRING=
SEEDGRID_SECURITY_AVATAR_AZURE_BLOB_CONTAINER=
SEEDGRID_SECURITY_AVATAR_AZURE_BLOB_ACCOUNT_NAME=
SEEDGRID_SECURITY_AVATAR_AZURE_BLOB_ACCOUNT_KEY=

# Google Drive
SEEDGRID_SECURITY_AVATAR_GOOGLE_DRIVE_ROOT_FOLDER_ID=
SEEDGRID_SECURITY_AVATAR_GOOGLE_DRIVE_CREDENTIALS_FILE=
SEEDGRID_SECURITY_AVATAR_GOOGLE_DRIVE_CREDENTIALS_JSON=

# OneDrive
SEEDGRID_SECURITY_AVATAR_ONEDRIVE_CLIENT_ID=
SEEDGRID_SECURITY_AVATAR_ONEDRIVE_CLIENT_SECRET=
SEEDGRID_SECURITY_AVATAR_ONEDRIVE_TENANT_ID=
SEEDGRID_SECURITY_AVATAR_ONEDRIVE_ROOT_FOLDER_PATH=/seedgrid/files

# Google Cloud Storage
SEEDGRID_SECURITY_AVATAR_GCS_BUCKET=
SEEDGRID_SECURITY_AVATAR_GCS_PROJECT_ID=
SEEDGRID_SECURITY_AVATAR_GCS_CREDENTIALS_FILE=
SEEDGRID_SECURITY_AVATAR_GCS_CREDENTIALS_JSON=

# ========================================
# AUDIT
# ========================================
# AUDIT_STRATEGY=JPA
# SEEDGRID_AUDIT_DB_KIND=postgresql
# SEEDGRID_AUDIT_DB_USERNAME=
# SEEDGRID_AUDIT_DB_PASSWORD=
# SEEDGRID_AUDIT_DB_URL=
# SEEDGRID_AUDIT_MONGODB_URI=mongodb://admin:admin@localhost:27017

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG
LOG_FILEMANAGEMENT_LEVEL=DEBUG
LOG_MINIO_LEVEL=DEBUG
LOG_OKHTTP_LEVEL=DEBUG
LOG_HIBERNATE_LEVEL=INFO
LOG_VERTX_MAIL_LEVEL=INFO
LOG_QUARKUS_MAILER_LEVEL=INFO
